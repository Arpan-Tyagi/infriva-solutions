# ==============================================================================
# INFRIVA SOLUTIONS - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and populate the values for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Canonical Site URL (SEO, Sitemap, OpenGraph & Schema.org)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.infrivasolutions.com"

# ------------------------------------------------------------------------------
# 1. Supabase (PostgreSQL Database & Client Authentication)
# ------------------------------------------------------------------------------
# Project URL found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anon Public API Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Service Role Secret Key (server-side only, bypasses RLS if needed)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. Google Gemini Generative AI (LLM Engine)
# ------------------------------------------------------------------------------
# API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 3. Resend (Transactional Email Delivery)
# ------------------------------------------------------------------------------
# API Key from Resend Dashboard (https://resend.com/api-keys)
RESEND_API_KEY="re_your_resend_api_key"

# Verified sender email address (e.g., 'Infriva Solutions <info@yourdomain.com>')
RESEND_FROM_EMAIL="Infriva Solutions <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 4. Meta for Developers (Instagram, Messenger & WhatsApp Webhooks)
# ------------------------------------------------------------------------------
# Meta App credentials from developers.facebook.com -> App Dashboard
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# Long-lived Page Access Token with pages_messaging, instagram_manage_messages permissions
META_ACCESS_TOKEN="your-meta-page-access-token"

# Custom secret verification string for webhook handshake (hub.verify_token)
META_WEBHOOK_VERIFY_TOKEN="your_custom_secure_webhook_verify_token"

# WhatsApp Cloud API Phone Number ID (optional, required if using direct WhatsApp API)
META_WHATSAPP_PHONE_ID="your-meta-whatsapp-phone-id"

# Threads App Credentials (optional)
THREADS_APP_ID="your-threads-app-id"
THREADS_APP_SECRET="your-threads-app-secret"

# ------------------------------------------------------------------------------
# 5. PostHog (AI Observability & Event Analytics)
# ------------------------------------------------------------------------------
# PostHog Project API Key from Project Settings -> Project API Key
POSTHOG_API_KEY="phc_your_posthog_project_api_key"

# PostHog Host Instance (e.g., 'https://us.i.posthog.com' or 'https://eu.i.posthog.com')
POSTHOG_HOST="https://us.i.posthog.com"

# ==============================================================================
# CRM (Sales & RevOps module)
# ==============================================================================

# Inngest background jobs (SLA timers, rep alerts, follow-ups, crons).
# Local: run `npx inngest-cli@latest dev` alongside `npm run dev` and leave these empty.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Team alerts on WhatsApp: an approved utility template with one body variable,
# e.g. name `crm_alert`, body "Infriva CRM: {{1}}". Uses META_ACCESS_TOKEN + META_WHATSAPP_PHONE_ID.
WHATSAPP_CRM_ALERT_TEMPLATE="crm_alert"
WHATSAPP_CRM_ALERT_LANG="en"

# Exotel click-to-call (rings the rep's own mobile first, then the lead; recorded)
EXOTEL_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_CALLER_ID=""                      # your ExoPhone
EXOTEL_SUBDOMAIN="api.in.exotel.com"     # Mumbai; api.exotel.com for Singapore
EXOTEL_CALLBACK_SECRET=""                # long random string; signs status-callback URLs

# Lead sources
GOOGLE_ADS_WEBHOOK_KEY=""                # the `google_key` set on the Google Ads lead form
META_LEAD_FORM_IDS=""                    # comma-separated, for the daily reconciliation job

# Enrichment (FullEnrich first, Apollo fallback)
FULLENRICH_API_KEY=""
FULLENRICH_CALLBACK_SECRET=""            # long random string; authenticates the FullEnrich webhook
APOLLO_API_KEY=""

# Closed-loop conversions (Meta CAPI on QUALIFIED / WON)
META_PIXEL_ID=""
META_TEST_EVENT_CODE=""                  # optional, for Events Manager → Test events

# Test personas + Role Simulator are on in development and off in production.
# NEXT_PUBLIC_CRM_TEST_PERSONAS="true"   # only to force them on in a staging deploy
# CRM_SEED_PASSWORD="Infriva2026!"       # password used by supabase/seed_test_logins.sql
